{
  "info": {
    "name": "AutoAndes Backend API - Examen Parcial II",
    "_postman_id": "autoandes-api-v1-upeu",
    "description": "Colección completa de pruebas con ejemplos para códigos HTTP 200, 201, 400, 401, 403, 404 y 409 según las reglas de negocio del caso AutoAndes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "token_admin",
      "value": "",
      "type": "string"
    },
    {
      "key": "token_asesor",
      "value": "",
      "type": "string"
    },
    {
      "key": "token_jefe",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Autenticación (Auth)",
      "item": [
        {
          "name": "1.1 Login Exitoso - ADMIN (200 OK)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Auto2026*\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "1.2 Login Exitoso - ASESOR (200 OK)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"asesor\",\n  \"password\": \"Auto2026*\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "1.3 Login Exitoso - JEFE TALLER (200 OK)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"jefe\",\n  \"password\": \"Auto2026*\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "1.4 Login Fallido - Credenciales Incorrectas o Inactivo (401 Unauthorized)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"inactivo\",\n  \"password\": \"Auto2026*\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "1.5 Obtener Perfil /auth/me (200 OK)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "2. Clientes",
      "item": [
        {
          "name": "2.1 Listar Clientes (200 OK)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_asesor}}" }
            ],
            "url": { "raw": "{{baseUrl}}/clientes", "host": ["{{baseUrl}}"], "path": ["clientes"] }
          }
        }
      ]
    },
    {
      "name": "3. Servicios (RN-01)",
      "item": [
        {
          "name": "3.1 Listar Servicios (200 OK)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_asesor}}" }
            ],
            "url": { "raw": "{{baseUrl}}/servicios", "host": ["{{baseUrl}}"], "path": ["servicios"] }
          }
        },
        {
          "name": "3.2 Crear Servicio Exitoso (201 Created)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_jefe}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"SRV-009\",\n  \"nombre\": \"Diagnóstico de frenos ABS\",\n  \"precio\": 110.00,\n  \"duracionMin\": 50,\n  \"activo\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/servicios", "host": ["{{baseUrl}}"], "path": ["servicios"] }
          }
        },
        {
          "name": "3.3 Crear Servicio - Código Duplicado (409 Conflict - RN-01)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_jefe}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"SRV-001\",\n  \"nombre\": \"Servicio Repetido\",\n  \"precio\": 100.00,\n  \"duracionMin\": 30,\n  \"activo\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/servicios", "host": ["{{baseUrl}}"], "path": ["servicios"] }
          }
        },
        {
          "name": "3.4 Eliminar Servicio con Órdenes Asociadas (409 Conflict - RN-01)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_jefe}}" }
            ],
            "url": { "raw": "{{baseUrl}}/servicios/1", "host": ["{{baseUrl}}"], "path": ["servicios", "1"] }
          }
        },
        {
          "name": "3.5 Alternar Estado Activo/Inactivo (200 OK)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_jefe}}" }
            ],
            "url": { "raw": "{{baseUrl}}/servicios/8/estado", "host": ["{{baseUrl}}"], "path": ["servicios", "8", "estado"] }
          }
        }
      ]
    },
    {
      "name": "4. Vehículos (RN-02)",
      "item": [
        {
          "name": "4.1 Listar Vehículos con Filtro Cliente (200 OK)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_asesor}}" }
            ],
            "url": { "raw": "{{baseUrl}}/vehiculos?clienteId=1", "host": ["{{baseUrl}}"], "path": ["vehiculos"], "query": [{ "key": "clienteId", "value": "1" }] }
          }
        },
        {
          "name": "4.2 Crear Vehículo Exitoso (201 Created)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_asesor}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"placa\": \"ZZZ-999\",\n  \"marca\": \"Honda\",\n  \"modelo\": \"Civic\",\n  \"anio\": 2021,\n  \"clienteId\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/vehiculos", "host": ["{{baseUrl}}"], "path": ["vehiculos"] }
          }
        },
        {
          "name": "4.3 Crear Vehículo - Placa Inválida (400 Bad Request)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_asesor}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"placa\": \"123-ABC\",\n  \"marca\": \"Honda\",\n  \"modelo\": \"Civic\",\n  \"anio\": 2021,\n  \"clienteId\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/vehiculos", "host": ["{{baseUrl}}"], "path": ["vehiculos"] }
          }
        },
        {
          "name": "4.4 Crear Vehículo - Placa Repetida (409 Conflict - RN-02)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_asesor}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"placa\": \"AAA-111\",\n  \"marca\": \"Toyota\",\n  \"modelo\": \"Corolla\",\n  \"anio\": 2020,\n  \"clienteId\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/vehiculos", "host": ["{{baseUrl}}"], "path": ["vehiculos"] }
          }
        },
        {
          "name": "4.5 Crear Vehículo - Cliente Inexistente (404 Not Found)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_asesor}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"placa\": \"XYZ-111\",\n  \"marca\": \"Nissan\",\n  \"modelo\": \"Versa\",\n  \"anio\": 2022,\n  \"clienteId\": 9999\n}"
            },
            "url": { "raw": "{{baseUrl}}/vehiculos", "host": ["{{baseUrl}}"], "path": ["vehiculos"] }
          }
        },
        {
          "name": "4.6 Eliminar Vehículo con Órdenes (409 Conflict - RN-02)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "url": { "raw": "{{baseUrl}}/vehiculos/1", "host": ["{{baseUrl}}"], "path": ["vehiculos", "1"] }
          }
        }
      ]
    },
    {
      "name": "5. Órdenes de Servicio (RN-03, RN-04, RN-05)",
      "item": [
        {
          "name": "5.1 Registrar Orden Exitosa (201 Created - RN-04)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_asesor}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehiculoId\": 1,\n  \"kilometraje\": 48000,\n  \"detalles\": [\n    {\n      \"servicioId\": 1,\n      \"cantidad\": 1\n    },\n    {\n      \"servicioId\": 2,\n      \"cantidad\": 1\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/ordenes", "host": ["{{baseUrl}}"], "path": ["ordenes"] }
          }
        },
        {
          "name": "5.2 Rechazo - Servicio Inactivo en Detalle (409 Conflict - RN-03)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_asesor}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehiculoId\": 1,\n  \"kilometraje\": 49000,\n  \"detalles\": [\n    {\n      \"servicioId\": 1,\n      \"cantidad\": 1\n    },\n    {\n      \"servicioId\": 8,\n      \"cantidad\": 1\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/ordenes", "host": ["{{baseUrl}}"], "path": ["ordenes"] }
          }
        },
        {
          "name": "5.3 Rechazo - Kilometraje Menor al Anterior (409 Conflict - RN-04)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_asesor}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehiculoId\": 1,\n  \"kilometraje\": 40000,\n  \"detalles\": [\n    {\n      \"servicioId\": 1,\n      \"cantidad\": 1\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/ordenes", "host": ["{{baseUrl}}"], "path": ["ordenes"] }
          }
        },
        {
          "name": "5.4 Rechazo - Servicios Duplicados en Detalles (400 Bad Request - RN-03)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_asesor}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehiculoId\": 1,\n  \"kilometraje\": 50000,\n  \"detalles\": [\n    {\n      \"servicioId\": 1,\n      \"cantidad\": 1\n    },\n    {\n      \"servicioId\": 1,\n      \"cantidad\": 2\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/ordenes", "host": ["{{baseUrl}}"], "path": ["ordenes"] }
          }
        },
        {
          "name": "5.5 Consultar Órdenes con Filtros Combinables (200 OK)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_asesor}}" }
            ],
            "url": { "raw": "{{baseUrl}}/ordenes?estado=REGISTRADA", "host": ["{{baseUrl}}"], "path": ["ordenes"], "query": [{ "key": "estado", "value": "REGISTRADA" }] }
          }
        },
        {
          "name": "5.6 Anular Orden - Fecha Anterior a Hoy (409 Conflict - RN-05)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_jefe}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"motivo\": \"Cliente decide no realizar servicio por costo\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/ordenes/1/anular", "host": ["{{baseUrl}}"], "path": ["ordenes", "1", "anular"] }
          }
        },
        {
          "name": "5.7 Acceso Denegado - Asesor Intentando Anular Orden (403 Forbidden)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_asesor}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"motivo\": \"Intento de anulación sin permiso\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/ordenes/1/anular", "host": ["{{baseUrl}}"], "path": ["ordenes", "1", "anular"] }
          }
        }
      ]
    },
    {
      "name": "6. Reportes",
      "item": [
        {
          "name": "6.1 Reporte Ingresos por Servicio (200 OK)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_jefe}}" }
            ],
            "url": { "raw": "{{baseUrl}}/reportes/ingresos-por-servicio", "host": ["{{baseUrl}}"], "path": ["reportes", "ingresos-por-servicio"] }
          }
        },
        {
          "name": "6.2 Acceso Denegado - Asesor Intentando Ver Reporte (403 Forbidden)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_asesor}}" }
            ],
            "url": { "raw": "{{baseUrl}}/reportes/ingresos-por-servicio", "host": ["{{baseUrl}}"], "path": ["reportes", "ingresos-por-servicio"] }
          }
